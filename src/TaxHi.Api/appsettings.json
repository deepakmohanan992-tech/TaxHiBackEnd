{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MarvelAutomation;Integrated Security=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "JwtIssuer": "TaxHi",
    "JwtAudience": "TaxHi.Client",
    "JwtSigningKey": "CHANGE_THIS_DEVELOPMENT_KEY_TO_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "OtpExpiryMinutes": 5,
    "OtpMaxAttempts": 5,
    "OtpResendCooldownSeconds": 60,
    "GuestAccessTokenDays": 1
  }
}
